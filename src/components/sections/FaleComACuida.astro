---
import { Image } from "astro:assets";
import { contatos } from "../../data/contatos";
import logo from "../../assets/logo-cuida.png";
import foto from "../../assets/rodape-cuidadora-idosa.png";
import CtaWhatsApp from "../ui/CtaWhatsApp.astro";

const atributos = [
  "Experiência real",
  "Equipe capacitada",
  "Atendimento humanizado",
  "Apoio à família",
  "Cursos e Palestras",
  "Suporte ILPI",
];
---

<footer class="fale" id="contato">
  <div class="container fale__grid">
    <div class="fale__coluna">
      <Image
        src={logo}
        alt="Cuida Home Care"
        widths={[160, 320]}
        sizes="160px"
        loading="lazy"
        class="fale__logo"
      />

      <h2 class="visually-hidden">Fale com a Cuida</h2>

      <div class="fale__cta">
        <CtaWhatsApp texto="Fale com a Cuida" blocoNoMobile={true} />
      </div>

      <ul class="fale__atributos">
        {atributos.map((item) => <li>{item}</li>)}
      </ul>

      <ul class="fale__contatos">
        <li>
          <a class="contato" href={contatos.telefoneLink}>
            <span class="contato__icone" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path
                  d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"
                ></path>
              </svg>
            </span>
            {contatos.telefoneExibido}
          </a>
        </li>
        <li>
          <a class="contato" href={`mailto:${contatos.email}`}>
            <span class="contato__icone" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                <path d="m2 7 10 6 10-6"></path>
              </svg>
            </span>
            {contatos.email}
          </a>
        </li>
        <li>
          <a
            class="contato"
            href={contatos.instagram}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="contato__icone" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect x="3" y="3" width="18" height="18" rx="5"></rect>
                <circle cx="12" cy="12" r="4"></circle>
                <circle cx="17.5" cy="6.5" r="1" fill="currentColor"></circle>
              </svg>
            </span>
            @cuidahomecare
            <span class="visually-hidden">(Instagram, abre em nova aba)</span>
          </a>
        </li>
        <li>
          <a
            class="contato"
            href={contatos.avaliacaoGoogle}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="contato__icone" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path
                  d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2L12 17.3 6.4 20.2l1.1-6.2L3 9.6l6.2-.9z"
                ></path>
              </svg>
            </span>
            Avaliação Google
            <span class="visually-hidden">(abre em nova aba)</span>
          </a>
        </li>
      </ul>
    </div>

    <div class="fale__visual">
      <Image
        src={foto}
        alt="Cuidadora da Cuida Home Care conversando com uma senhora idosa na sala de casa"
        widths={[390, 780, 1285]}
        sizes="(min-width: 1024px) 50vw, 100vw"
        loading="lazy"
        class="fale__img"
      />
    </div>
  </div>
</footer>

<style>
  .fale {
    background: var(--bg-pagina);
    padding-block: var(--esp-secao);
    /* Folga para o CTA flutuante não cobrir o último contato */
    padding-bottom: calc(var(--esp-secao) + var(--fab-folga-rodape));
  }

  .fale__grid {
    display: grid;
    gap: var(--esp-12);
  }

  /* Sem isto, o e-mail (uma palavra longa e inquebrável) impede a coluna de
     encolher e cria rolagem horizontal em 360px. min-width:auto é o padrão
     de itens de grid/flex e precisa ser zerado. */
  .fale__coluna {
    min-width: 0;
  }

  .fale__logo {
    width: 160px;
    height: auto;
    margin-bottom: var(--esp-6);
  }

  .fale__cta {
    margin-bottom: var(--esp-8);
  }

  .fale__atributos {
    display: grid;
    gap: var(--esp-2);
    font-style: italic;
    font-size: var(--fs-body);
    margin-bottom: var(--esp-8);
  }

  .fale__contatos {
    display: grid;
    gap: var(--esp-2);
  }

  /* Linha inteira tocável: a maior correção de usabilidade mobile da página.
     Hoje são textos soltos, impossíveis de acertar com o dedo. */
  .contato {
    display: flex;
    align-items: center;
    gap: var(--esp-3);
    min-width: 0;
    min-height: var(--alvo-min);
    padding-inline: var(--esp-2);
    border-radius: var(--raio-card);
    font-size: var(--fs-body);
    overflow-wrap: anywhere;
  }

  .contato:hover {
    background: color-mix(in srgb, var(--cor-roxo) 12%, transparent);
  }

  .contato__icone {
    display: block;
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    color: var(--cor-roxo);
  }

  .contato__icone :global(svg) {
    width: 100%;
    height: 100%;
  }

  .fale__img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: var(--raio-card);
  }

  @media (min-width: 1024px) {
    .fale__grid {
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: var(--esp-24);
    }

    .fale {
      padding-bottom: var(--esp-secao);
    }
  }
</style>
