---
import { contatos } from "../../data/contatos";
---

<a
  class="fab"
  href={contatos.whatsappOrcamento}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Falar com a Cuida no WhatsApp"
>
  <svg
    viewBox="0 0 24 24"
    fill="currentColor"
    aria-hidden="true"
    focusable="false"
  >
    <path
      d="M17.5 14.4c-.3-.2-1.8-.9-2-1-.3-.1-.5-.2-.7.1-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1a8 8 0 0 1-2.4-1.5 9 9 0 0 1-1.6-2c-.2-.3 0-.5.1-.6l.5-.6.3-.5v-.5l-1-2.3c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.2.2 2.2 3.4 5.3 4.7.7.3 1.3.5 1.8.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.4.3-.7.3-1.3.2-1.4 0-.2-.2-.3-.5-.4zM12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3.1.8.8-3-.2-.3A8.2 8.2 0 1 1 12 20.2z"
    ></path>
  </svg>
</a>

<style>
  /**
   * CTA flutuante — aprovado pelo Lucas em 17/09 (docs/front-end-spec-mobile.md §7).
   * Único elemento novo da página em relação ao site atual.
   *
   * Sem JavaScript: o orçamento da arquitetura é 0 KB. O botão fica visível desde
   * o início no mobile, em vez de aparecer após o scroll.
   */
  .fab {
    position: fixed;
    right: var(--fab-margem);
    bottom: calc(var(--fab-margem) + env(safe-area-inset-bottom, 0px));
    z-index: var(--fab-z);
    display: grid;
    place-items: center;
    width: var(--fab-tamanho);
    height: var(--fab-tamanho);
    border-radius: 50%;
    /* Verde escuro da marca: o verde claro (#25D366) dá 2,02:1 com o ícone
       branco e reprova o mínimo de 3:1 para elemento gráfico. Este dá 4,19:1. */
    background: var(--cor-whatsapp);
    color: var(--cor-branco);
    box-shadow: 0 4px 12px rgb(0 0 0 / 25%);
  }

  .fab svg {
    width: 28px;
    height: 28px;
  }

  /* O desktop é fidelidade ao site atual e não ganha elemento novo (FR2) */
  @media (min-width: 1024px) {
    .fab {
      display: none;
    }
  }
</style>
